# Public canonical URL used for metadata and shared links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GitHub Pages tarayıcı istemcisi için Supabase bağlantısı. Publishable key gizli değildir;
# güvenlik veritabanındaki RLS kurallarıyla sağlanır. Secret/service-role anahtarı kullanmayın.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credentials. Never prefix the service role key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared, serverless-safe submission rate limiting (required in production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=replace-with-a-long-random-value

# Comma-separated, normalized words to block. This is a basic safeguard, not complete moderation.
MODERATION_BLOCKLIST=
